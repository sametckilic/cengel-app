{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": "./apps/mobile",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "apps/mobile/.expo/types/**/*.ts",
    "apps/mobile/expo-env.d.ts"
  ]
}
