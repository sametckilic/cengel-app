{
  "name": "cengel-platform",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @cengel/mobile run start --",
    "reset-project": "npm --workspace @cengel/mobile run reset-project --",
    "dataset:check": "node ./scripts/prepare-clue-catalog.js --check",
    "dataset:build": "node ./scripts/prepare-clue-catalog.js --output ./apps/mobile/data/generated/clue-catalog.json",
    "puzzles:check": "node ./scripts/generate-puzzle-manifest.js --check",
    "puzzles:build": "node ./scripts/generate-puzzle-manifest.js --output ./apps/mobile/data/generated/puzzles.json",
    "daily:generate": "node ./scripts/generate-daily-puzzle.js",
    "daily:publish": "node ./scripts/publish-daily-puzzles.js",
    "newspaper:report": "node ./scripts/analyze-newspaper-readiness.js",
    "newspaper:prototype:check": "node ./scripts/generate-newspaper-prototype.js --check",
    "newspaper:prototype:build": "node ./scripts/generate-newspaper-prototype.js --output ./apps/mobile/data/generated/newspaper-prototype-8x8.json",
    "test:engine": "node --test ./scripts/puzzle-selection.test.js",
    "test:progress": "node --test ./scripts/puzzle-progress.test.js",
    "test:generator": "node --test ./scripts/clue-selection.test.js ./scripts/daily-puzzle-batch.test.js ./scripts/daily-puzzle-publication.test.js ./scripts/daily-puzzle-quality.test.js ./scripts/daily-puzzle-recipe.test.js ./scripts/daily-puzzle-schedule.test.js ./scripts/newspaper-fill.test.js ./scripts/newspaper-grid.test.js ./scripts/puzzle-layout.test.js ./scripts/puzzle-manifest.test.js",
    "android": "npm --workspace @cengel/mobile run android --",
    "ios": "npm --workspace @cengel/mobile run ios --",
    "web": "npm --workspace @cengel/mobile run web --",
    "server:build": "npm --workspace @cengel/mobile run server:build --",
    "server:serve": "npm --workspace @cengel/mobile run server:serve --",
    "lint": "npm --workspace @cengel/mobile run lint --"
  },
  "private": true
}
