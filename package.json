{
  "name": "cengel-platform",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @cengel/mobile run start --",
    "api:build": "npm --workspace @cengel/api run build",
    "api:content:import": "npm --workspace @cengel/api run content:import",
    "api:db:check": "npm --workspace @cengel/api run db:check",
    "api:db:generate": "npm --workspace @cengel/api run db:generate",
    "api:db:migrate": "npm --workspace @cengel/api run db:migrate",
    "api:docker:build": "docker build -f apps/api/Dockerfile -t cengel-api:local .",
    "api:dev": "npm --workspace @cengel/api run dev",
    "api:start": "npm --workspace @cengel/api run start",
    "api:test": "npm --workspace @cengel/api run test",
    "reset-project": "npm --workspace @cengel/mobile run reset-project --",
    "dataset:check": "node ./packages/generator/bin/prepare-clue-catalog.js --check",
    "dataset:build": "node ./packages/generator/bin/prepare-clue-catalog.js --output ./apps/mobile/data/generated/clue-catalog.json",
    "puzzles:check": "node ./packages/generator/bin/generate-puzzle-manifest.js --check",
    "puzzles:build": "node ./packages/generator/bin/generate-puzzle-manifest.js --output ./apps/mobile/data/generated/puzzles.json",
    "daily:generate": "node ./packages/generator/bin/generate-daily-puzzle.js",
    "daily:publish": "node ./packages/generator/bin/publish-daily-puzzles.js",
    "newspaper:report": "node ./packages/generator/bin/analyze-newspaper-readiness.js",
    "newspaper:prototype:check": "node ./packages/generator/bin/generate-newspaper-prototype.js --check",
    "newspaper:prototype:build": "node ./packages/generator/bin/generate-newspaper-prototype.js --output ./apps/mobile/data/generated/newspaper-prototype-8x8.json",
    "test:engine": "node --test ./packages/puzzle-core/test/puzzle-selection.test.js",
    "test:progress": "node --test ./packages/puzzle-core/test/puzzle-progress.test.js",
    "test:generator": "node --test ./packages/generator/test/clue-selection.test.js ./packages/generator/test/daily-puzzle-batch.test.js ./packages/generator/test/daily-puzzle-publication.test.js ./packages/generator/test/daily-puzzle-quality.test.js ./packages/generator/test/daily-puzzle-recipe.test.js ./packages/generator/test/daily-puzzle-schedule.test.js ./packages/generator/test/newspaper-fill.test.js ./packages/generator/test/newspaper-grid.test.js ./packages/generator/test/puzzle-layout.test.js ./packages/generator/test/puzzle-manifest.test.js",
    "android": "npm --workspace @cengel/mobile run android --",
    "ios": "npm --workspace @cengel/mobile run ios --",
    "web": "npm --workspace @cengel/mobile run web --",
    "server:build": "npm --workspace @cengel/mobile run server:build --",
    "server:serve": "npm --workspace @cengel/mobile run server:serve --",
    "lint": "npm run lint:mobile && npm run lint:api",
    "lint:api": "npm --workspace @cengel/api run lint",
    "lint:mobile": "npm --workspace @cengel/mobile run lint --"
  },
  "private": true
}
