# Public API origin used by Android, iOS, and web catalog synchronization.
# When omitted, web keeps using the legacy same-origin /api/puzzles fallback.
EXPO_PUBLIC_PUZZLE_API_URL=https://cengel-api-staging.up.railway.app

# Public Supabase project values. Anonymous auth remains disabled when omitted.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
