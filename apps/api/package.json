{
  "name": "@cengel/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "content:import": "npm run build && node dist/content/import-content.js",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run build && node dist/database/migrate.js",
    "dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cengel/achievement-core": "*",
    "@cengel/contracts": "*",
    "@cengel/puzzle-core": "*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
